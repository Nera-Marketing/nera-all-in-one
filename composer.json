{
    "name": "nera/nera-all-in-one",
    "description": "Nera All In One — unified manager for Nera internal plugins + licensing.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "Nera\\AllInOne\\": "src/"
        },
        "classmap": [
            "modules/"
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
